# CTRL API — systemd unit
# Put at /etc/systemd/system/ctrl.service, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now ctrl

[Unit]
Description=CTRL API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/ctrl
ExecStart=/usr/bin/node server/index.mjs
Restart=on-failure
RestartSec=2

Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
# Opening hours are computed in local time; the server must agree with Pula.
Environment=TZ=Europe/Zagreb
# Users, applications and reservations live here, outside the deployed code,
# so rsync --delete on a deploy never touches them.
Environment=CTRL_LOCAL_STORE_DIR=/var/lib/ctrl
# Optional: SESSION_SECRET=… Without it a secret is generated once and kept
# in the store above.
EnvironmentFile=-/etc/ctrl.env

# No dedicated user to create: systemd allocates one and owns the state dir.
DynamicUser=yes
StateDirectory=ctrl
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
